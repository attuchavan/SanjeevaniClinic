# Sanjeevani Clinic Management System
# Backend Environment Configuration

# Server Network Settings
# HOST 0.0.0.0 binds to all network interfaces for LAN connectivity
HOST=0.0.0.0
PORT=5000
NODE_ENV=development

# Database Configuration (stored locally on Computer 1)
DB_PATH=./data/clinic.db

# Authentication & Security
JWT_SECRET=sanjeevani_clinic_local_master_secret_key_2026_secured
JWT_EXPIRES_IN=12h

# CORS Configuration (allows local network frontend connections)
CORS_ORIGIN=*

# Clinic Information
CLINIC_NAME="SANJEEVANI CLINIC"
